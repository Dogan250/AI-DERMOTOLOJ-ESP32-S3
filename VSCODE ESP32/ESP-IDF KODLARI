// OLED Pinleri (VCC -> 3V3, GND -> GND, SDA -> 17, SCL -> 18)
#define OLED_SDA GPIO_NUM_17
#define OLED_SCL GPIO_NUM_18
#define OLED_ADRES 0x3C

