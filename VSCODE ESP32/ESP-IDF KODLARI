// --- SAF GPIO I2C SÜRÜCÜSÜ ---
static void i2c_gecikme(void) { esp_rom_delay_us(2); }

static void i2c_basla(void) {
    gpio_set_level(OLED_SDA, 1);
    gpio_set_level(OLED_SCL, 1);
    i2c_gecikme();
    gpio_set_level(OLED_SDA, 0);
    i2c_gecikme();
    gpio_set_level(OLED_SCL, 0);
}

static void i2c_dur(void) {
    gpio_set_level(OLED_SDA, 0);
    gpio_set_level(OLED_SCL, 1);
    i2c_gecikme();
    gpio_set_level(OLED_SDA, 1);
    i2c_gecikme();
}

static void i2c_byte_yaz(uint8_t veri) {
    for (int i = 7; i >= 0; i--) {
        gpio_set_level(OLED_SDA, (veri >> i) & 0x01);
        i2c_gecikme();
        gpio_set_level(OLED_SCL, 1);
        i2c_gecikme();
        gpio_set_level(OLED_SCL, 0);
    }
    gpio_set_level(OLED_SDA, 1);
    i2c_gecikme();
    gpio_set_level(OLED_SCL, 1);
    i2c_gecikme();
    gpio_set_level(OLED_SCL, 0);
}

static void oled_komut(uint8_t cmd) {
    i2c_basla();
    i2c_byte_yaz(OLED_ADRES << 1);
    i2c_byte_yaz(0x00);
    i2c_byte_yaz(cmd);
    i2c_dur();
}

static void oled_baslat(void) {
    gpio_config_t io_conf = {
        .intr_type = GPIO_INTR_DISABLE,
        .mode = GPIO_MODE_INPUT_OUTPUT_OD,
        .pin_bit_mask = (1ULL << OLED_SDA) | (1ULL << OLED_SCL),
        .pull_down_en = 0,
        .pull_up_en = 1,
    };
    gpio_config(&io_conf);
    gpio_set_level(OLED_SDA, 1);
    gpio_set_level(OLED_SCL, 1);
    vTaskDelay(pdMS_TO_TICKS(50));

    uint8_t baslangic_komutlari[] = {
        0xAE, 0x20, 0x00, 0xB0, 0xC8, 0x00, 0x10, 0x40,
        0x81, 0xFF, 0xA1, 0xA6, 0xA8, 0x3F, 0xA4, 0xD3,
        0x00, 0xD5, 0xF0, 0xD9, 0x22, 0xDA, 0x12, 0xDB,
        0x20, 0x8D, 0x14, 0xAF
    };
    for (size_t i = 0; i < sizeof(baslangic_komutlari); i++) {
        oled_komut(baslangic_komutlari[i]);
    }
}

static void oled_temizle(void) {
    memset(ekran_tamponu, 0, sizeof(ekran_tamponu));
}

static void oled_guncelle(void) {
    for (uint8_t sayfa = 0; sayfa < 8; sayfa++) {
        oled_komut(0xB0 + sayfa);
        oled_komut(0x00);
        oled_komut(0x10);

        i2c_basla();
        i2c_byte_yaz(OLED_ADRES << 1);
        i2c_byte_yaz(0x40);
        for (int i = 0; i < 128; i++) {
            i2c_byte_yaz(ekran_tamponu[sayfa * 128 + i]);
        }
        i2c_dur();
    }
}

